{{ range $idx,$view := .Views }}
  <section data-view="{{ $idx }}"
           data-index-view="{{ $view.Key }}"
           data-view-present="{{ $view.Present }}"{{- if $view.NoThumbnails }}
           data-no-thumbnails="true"{{ end -}}>
        {{ if eq $view.Key "link-list" }}
            {{ template "partials/njn/block/index-view--link-list.tmpl" (dict $ "ThisView" $view) }}
        {{ else if eq $view.Key "profile" }}
            {{ template "partials/njn/block/index-view--profile.tmpl" (dict $ "ThisView" $view) }}
        {{ else if eq $view.Key "card" }}
            {{ template "partials/njn/block/index-view--card.tmpl" (dict $ "ThisView" $view) }}
        {{ end }}
    </section>
{{ end }}